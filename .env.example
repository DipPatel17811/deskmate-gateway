# Copy this file to .env and edit it. Never commit .env.

# echo = loopback only, mock = offline full pipeline, auto = real when keys exist
MODE=auto

HOST=0.0.0.0
PORT=8765

# Shared secret required in the device hello. Set this on Render; leave blank
# for local development so the gateway accepts any LAN client.
DEVICE_TOKEN=

# Free-tier keys (dev only). Leave blank to use the offline mock providers.
GROQ_API_KEY=
GEMINI_API_KEY=

# Models
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_PROVIDER=groq
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.1-flash-lite
EDGE_VOICE=en-US-AriaNeural

# 1.0 = send TTS audio at real time, 0 = as fast as possible
TTS_PACE=1.0
TTS_PREBUFFER=1.5
# Conversation turns kept per device connection (0 disables memory)
MAX_HISTORY_TURNS=8

# Optional Postgres history. Use the Render *internal* connection string on
# Render (the external one needs an IP allow-list entry). Leave blank to keep
# history on the device only. Render's free Postgres expires 30 days after
# creation; upgrade the plan or point this at another Postgres before then.
DATABASE_URL=

SYSTEM_PROMPT=You are Desk Mate, a concise, friendly voice assistant on a small desk device. Reply in one to three short sentences. Use plain spoken English, no markdown, no lists, and no emoji. Use the recent conversation to resolve follow-ups such as 'that' or 'the same' instead of asking for context that is already in the conversation.
